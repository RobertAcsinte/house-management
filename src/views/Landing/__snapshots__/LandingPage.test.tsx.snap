            class="_wrapperSection_e55ede"
          >
            <h1
              class="_title_e55ede"
            >
              Manage your house
            </h1>
            <p
              class="_description_e55ede"
            >
              You can always manage the house that you are part of. You can change the name of it, add members and see the pending invitations!
            </p>
            <img
              alt="Description of the feature"
              class="_image_e55ede"
              src="/src/assets/myhouse.png"
            />
          </div>
        </section>
      </main>
    </div>
